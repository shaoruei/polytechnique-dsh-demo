+class ParseDurationTest(unittest.TestCase):
+    def test_valid_cases(self):
+        cases = [
+            ("0", 0),
+            ("0s", 0),
+            ("45s", 45),
+            ("90s", 90),
+            ("2d", 2 * 86400),
+            ("1h30m", 5400),
+            ("1h 30m", 5400),
+            ("1H30M", 5400),
+            ("1d2h3m4s", 93784),
+            ("120", 120),
+        ]
+        for text, expected in cases:
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), expected)
+
+    def test_invalid_cases(self):
+        invalids = [
+            "", "   ", "-5s", "-5", "1.5h", "1h30.5m", "3w", "h", "1h30", "30m1h",
+            "1h1h", "1h 30", "123abc", "1h30m4s2m"
+        ]
+        for text in invalids:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_roundtrip(self):
+        # Test a selection of values to ensure parse_duration(format_duration(n)) == n
+        for n in [0, 1, 59, 60, 61, 3599, 3600, 3601, 86399, 86400, 86401, 123456, 90061]:
+            with self.subTest(seconds=n):
+                self.assertEqual(parse_duration(format_duration(n)), n)
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/timeutil/duration.py b/timeutil/duration.py
