diff --git a/timeutil/duration.py b/timeutil/duration.py
index ca557cd..cced64c 100644
--- a/timeutil/duration.py
+++ b/timeutil/duration.py
@@ -34,4 +34,43 @@ def parse_duration(text: str) -> int:
       unknown units like "3w", missing number like "h") raises ValueError.
     * The result must satisfy parse_duration(format_duration(n)) == n.
     """
-    raise NotImplementedError
+    # Strip outer whitespace
+    s = text.strip()
+    if not s:
+        raise ValueError("invalid duration string")
+
+    # Bare integer (no units) -> seconds
+    if s.isdigit():
+        return int(s)
+
+    import re
+    pattern = re.compile(r"(\d+)([dhmsDHMS])")
+    pos = 0
+    total_seconds = 0
+    seen_units = set()
+    order_map = {"d": 0, "h": 1, "m": 2, "s": 3}
+    last_order = -1
+    unit_to_seconds = {suffix: size for suffix, size in _UNITS}
+    while pos < len(s):
+        # Skip any whitespace between components
+        if s[pos].isspace():
+            pos += 1
+            continue
+        m = pattern.match(s, pos)
+        if not m:
+            raise ValueError("invalid duration string")
+        number = int(m.group(1))
+        unit = m.group(2).lower()
+        # Validate unit
+        if unit not in order_map:
+            raise ValueError("invalid unit")
+        if unit in seen_units:
+            raise ValueError("duplicate unit")
+        current_order = order_map[unit]
+        if last_order != -1 and current_order <= last_order:
+            raise ValueError("units out of order")
+        seen_units.add(unit)
+        total_seconds += number * unit_to_seconds[unit]
+        last_order = current_order
+        pos = m.end()
+    return total_seconds
