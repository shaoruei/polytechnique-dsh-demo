+class ParseDurationTest(unittest.TestCase):
+    def test_valid(self):
+        self.assertEqual(parse_duration("0"), 0)
+        self.assertEqual(parse_duration("0s"), 0)
+        self.assertEqual(parse_duration("120"), 120)
+        self.assertEqual(parse_duration("1h30m"), 5400)
+        self.assertEqual(parse_duration("1d1h1m1s"), 90061)
+        self.assertEqual(parse_duration("1d 2h 3m 4s"), 93784)
+        self.assertEqual(parse_duration("2D"), 172800)
+        self.assertEqual(parse_duration("   5m   "), 300)
+
+    def test_invalid(self):
+        for txt in ["", "-5s", "1.5h", "30m1h", "1h1h", "1h 30x", "h10"]:
+            with self.subTest(txt=txt):
+                self.assertRaises(ValueError, parse_duration, txt)
+
 if __name__ == "__main__":
     unittest.main()
