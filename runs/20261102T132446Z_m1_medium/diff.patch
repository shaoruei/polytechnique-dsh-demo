 """Late-submission policy."""
 
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timedelta
 
 
 @dataclass(frozen=True)
@@ -13,4 +13,21 @@ class LatePolicy:
 
     def penalty(self, submitted_at: datetime, deadline: datetime) -> float:
         """Fraction of the score removed for a late submission (see SPEC.md)."""
-        return 0.0
+        # Compute lateness
+        if submitted_at <= deadline:
+            return 0.0
+        # Grace period
+        grace_delta = timedelta(minutes=self.grace_minutes)
+        if submitted_at <= deadline + grace_delta:
+            return 0.0
+        late_by = submitted_at - deadline
+        # Days late: ceil(late_by / 1 day)
+        days_late = (late_by + timedelta(days=1) - timedelta(seconds=1)).days  # alternative: use math.ceil
+        # Using math.ceil for clarity
+        import math
+        days_late = math.ceil(late_by.total_seconds() / 86400)
+        # Zero after cutoff
+        if late_by > timedelta(days=self.zero_after_days):
+            return 1.0
+        penalty = min(days_late * self.penalty_per_day, self.max_penalty)
+        return penalty
