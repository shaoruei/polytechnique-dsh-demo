diff --git a/submissions/policy.py b/submissions/policy.py
index f6b0165..7f9074b 100644
--- a/submissions/policy.py
+++ b/submissions/policy.py
@@ -1,7 +1,7 @@
 """Late-submission policy."""
 
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timedelta
 
 
 @dataclass(frozen=True)
@@ -12,5 +12,22 @@ class LatePolicy:
     zero_after_days: int = 7
 
     def penalty(self, submitted_at: datetime, deadline: datetime) -> float:
-        """Fraction of the score removed for a late submission (see SPEC.md)."""
-        return 0.0
+        """Fraction of the score removed for a late submission (see SPEC.md).
+
+        Returns a value in ``[0.0, 1.0]`` representing the fraction of the original
+        score that should be deducted.
+        """
+        # Compute raw lateness
+        late_by = submitted_at - deadline
+        # On time or within the grace period → no penalty
+        if late_by <= timedelta(minutes=self.grace_minutes):
+            return 0.0
+        # If lateness exceeds zero_after_days (strictly) → full penalty
+        if late_by > timedelta(days=self.zero_after_days):
+            return 1.0
+        # Compute started days late, counted from the deadline (not from end of grace)
+        # ``ceil`` of total seconds divided by a day.
+        from math import ceil
+        days_late = ceil(late_by.total_seconds() / 86400)
+        penalty = min(days_late * self.penalty_per_day, self.max_penalty)
+        return penalty
diff --git a/submissions/timeparse.py b/submissions/timeparse.py
index 01c7891..2327092 100644
--- a/submissions/timeparse.py
+++ b/submissions/timeparse.py
@@ -4,5 +4,13 @@ from datetime import datetime
 
 
 def parse_timestamp(text: str) -> datetime:
-    """Parse an ISO 8601 timestamp such as 2026-10-12T23:59:00+02:00."""
-    return datetime.fromisoformat(text.strip())
+    """Parse an ISO 8601 timestamp with a required UTC offset.
+
+    The platform export mandates that timestamps include a timezone offset.
+    ``datetime.fromisoformat`` accepts naive timestamps, so we enforce the
+    presence of ``tzinfo`` and raise ``ValueError`` otherwise.
+    """
+    dt = datetime.fromisoformat(text.strip())
+    if dt.tzinfo is None:
+        raise ValueError("timestamp missing UTC offset")
+    return dt
