 def _rows(text: str) -> List[List[str]]:
-    lines = text.splitlines()
-    return [line.split(",") for line in lines[1:]]
+    """Parse CSV text into rows, handling quoted fields and stripping whitespace.
+
+    Returns a list of rows (each a list of strings) for all non‑empty data lines
+    after the header. Blank lines are ignored. Whitespace around each field is
+    stripped, matching the specification.
+    """
+    import csv
+    from io import StringIO
+    # Use csv reader to respect quoting and commas inside quoted fields.
+    f = StringIO(text)
+    reader = csv.reader(f)
+    rows: List[List[str]] = []
+    for i, row in enumerate(reader):
+        if i == 0:
+            # Skip header line
+            continue
+        # Skip blank lines (row may be empty)
+        if not row:
+            continue
+        # Strip whitespace around each field
+        rows.append([field.strip() for field in row])
+    return rows
 
 
 def read_submissions(text: str) -> List[Submission]:
     """Parse the submissions export (header: student_id,name,assignment,submitted_at,score)."""
-    out = []
-    for row in _rows(text):
-        student_id, name, assignment, submitted_at, score = row
-        out.append(Submission(student_id, name, assignment, parse_timestamp(submitted_at), float(score)))
+    out: List[Submission] = []
+    for idx, row in enumerate(_rows(text), start=2):  # data rows start at line 2
+        if len(row) != 5:
+            raise ValueError(f"line {idx}: expected 5 fields, got {len(row)}")
+        student_id, name, assignment, submitted_at_str, score_str = row
+        try:
+            submitted_at = parse_timestamp(submitted_at_str)
+        except ValueError as e:
+            raise ValueError(f"line {idx}: {e}")
+        try:
+            score = float(score_str)
+        except ValueError as e:
+            raise ValueError(f"line {idx}: {e}")
+        out.append(Submission(student_id, name, assignment, submitted_at, score))
     return out
 
 
 def read_assignments(text: str) -> Dict[str, Assignment]:
     """Parse the assignments file (header: assignment,deadline,max_score)."""
-    out = {}
-    for name, deadline, max_score in _rows(text):
-        out[name] = Assignment(name, parse_timestamp(deadline), float(max_score))
+    out: Dict[str, Assignment] = {}
+    for idx, row in enumerate(_rows(text), start=2):
+        if len(row) != 3:
+            raise ValueError(f"line {idx}: expected 3 fields, got {len(row)}")
+        name, deadline_str, max_score_str = row
+        try:
+            deadline = parse_timestamp(deadline_str)
+        except ValueError as e:
+            raise ValueError(f"line {idx}: {e}")
+        try:
+            max_score = float(max_score_str)
+        except ValueError as e:
+            raise ValueError(f"line {idx}: {e}")
+        out[name] = Assignment(name, deadline, max_score)
     return out
