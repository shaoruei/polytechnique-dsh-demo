+def final_grades(
+    submissions: Iterable[Submission],
+    assignments: Dict[str, Assignment],
+    policy: LatePolicy,
+    roster: Optional[Iterable[str]] = None,
+) -> Dict[Tuple[str, str], float]:
+    """Compute final grades per (student_id, assignment).
+
+    Validates inputs, applies the late‑submission policy, selects the highest
+    adjusted score for each student/assignment pair and optionally fills missing
+    entries from a roster.
+    """
+    # Determine the best adjusted score for each (student, assignment).
+    best: Dict[Tuple[str, str], float] = {}
     for sub in submissions:
+        # Ensure the assignment exists.
+        if sub.assignment not in assignments:
+            raise ValueError(f"unknown assignment: {sub.assignment}")
+        assignment_obj = assignments[sub.assignment]
+        # Validate raw score bounds.
+        if not (0 <= sub.score <= assignment_obj.max_score):
+            raise ValueError(
+                f"score {sub.score} out of bounds for assignment {sub.assignment} (max {assignment_obj.max_score})"
+            )
+        # Apply late penalty.
+        penalty = policy.penalty(sub.submitted_at, assignment_obj.deadline)
+        adjusted = sub.score * (1 - penalty)
         key = (sub.student_id, sub.assignment)
-        if key not in latest or sub.submitted_at > latest[key].submitted_at:
-            latest[key] = sub
-    return {key: round(sub.score, 2) for key, sub in latest.items()}
+        # Keep the highest adjusted score.
+        if key not in best or adjusted > best[key]:
+            best[key] = adjusted
+    # If a roster is supplied, ensure every student/assignment pair appears.
+    if roster is not None:
+        for student_id in roster:
+            for assignment_name in assignments:
+                key = (student_id, assignment_name)
+                if key not in best:
+                    best[key] = 0.0
+    # Round final scores to two decimals.
+    return {key: round(score, 2) for key, score in best.items()}
