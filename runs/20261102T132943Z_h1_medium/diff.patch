+        totals: Dict[str, Decimal] = {}
+        for e in self.entries:
+            if e.month != month:
+                continue
+            totals.setdefault(e.user_id, Decimal("0"))
+            totals[e.user_id] += e.cost
+        # Remove zero cost entries
+        filtered = [(uid, cost) for uid, cost in totals.items() if cost != Decimal("0")]
+        # Sort by cost descending, then user_id ascending
+        filtered.sort(key=lambda x: (-x[1], x[0]))
