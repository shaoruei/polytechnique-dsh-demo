diff --git a/submissions/policy.py b/submissions/policy.py
index f6b0165..5049f19 100644
--- a/submissions/policy.py
+++ b/submissions/policy.py
@@ -1,7 +1,7 @@
 """Late-submission policy."""
 
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timedelta
 
 
 @dataclass(frozen=True)
@@ -13,4 +13,18 @@ class LatePolicy:
 
     def penalty(self, submitted_at: datetime, deadline: datetime) -> float:
         """Fraction of the score removed for a late submission (see SPEC.md)."""
-        return 0.0
+        # No penalty if submitted on time or within grace period
+        if submitted_at <= deadline + timedelta(minutes=self.grace_minutes):
+            return 0.0
+        # Compute total lateness from deadline (ignore grace period for day counting)
+        late_by = submitted_at - deadline
+        # If lateness exceeds zero_after_days, full penalty
+        if late_by > timedelta(days=self.zero_after_days):
+            return 1.0
+        # Number of started days late (ceil)
+        days_late = (late_by.total_seconds() / 86400)
+        # Use math.ceil to count started days
+        import math
+        days_late = math.ceil(days_late)
+        penalty = min(days_late * self.penalty_per_day, self.max_penalty)
+        return penalty
