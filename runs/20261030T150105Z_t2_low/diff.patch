diff --git a/timeutil/duration.py b/timeutil/duration.py
index ca557cd..be27847 100644
--- a/timeutil/duration.py
+++ b/timeutil/duration.py
@@ -34,4 +34,44 @@ def parse_duration(text: str) -> int:
       unknown units like "3w", missing number like "h") raises ValueError.
     * The result must satisfy parse_duration(format_duration(n)) == n.
     """
-    raise NotImplementedError
+    import re
+    orig_text = text
+    text = text.strip()
+    # reject trailing/leading whitespace when resulting in bare integer
+    if text.isdigit() and (orig_text != text):
+        raise ValueError("invalid format with whitespace")
+    if not text:
+        raise ValueError("empty duration")
+    # plain integer seconds
+    if text.isdigit():
+        return int(text)
+    # find components
+    # remove internal spaces for parsing
+    text_nospace = text.replace(' ', '')
+    pattern = re.compile(r"(\d+)([dhms])", re.IGNORECASE)
+    pos = 0
+    total = 0
+    seen = set()
+    last_index = -1
+    for m in pattern.finditer(text_nospace):
+        if m.start() != pos:
+            # there is unmatched text
+            raise ValueError(f"invalid format at position {pos}")
+        num = int(m.group(1))
+        unit = m.group(2).lower()
+        if unit in seen:
+            raise ValueError("duplicate unit")
+        # enforce decreasing order
+        unit_order = {u: i for i, (u, _) in enumerate(_UNITS)}
+        cur_index = unit_order[unit]
+        if cur_index <= last_index:
+            raise ValueError("units not in decreasing order")
+        seen.add(unit)
+        last_index = cur_index
+        # add seconds
+        size = dict(_UNITS)[unit]
+        total += num * size
+        pos = m.end()
+    if pos != len(text_nospace):
+        raise ValueError("trailing characters")
+    return total
