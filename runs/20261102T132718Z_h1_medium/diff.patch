diff --git a/gateway/pricing.py b/gateway/pricing.py
index 1598469..b7a7fd4 100644
--- a/gateway/pricing.py
+++ b/gateway/pricing.py
@@ -22,6 +22,19 @@ PRICES = {
 
 
 def request_cost(model: str, usage) -> Decimal:
-    """Cost of one provider call."""
+    """Cost of one provider call, rounded half-up to 6 decimals.
+
+    Calculates:
+        ((prompt_tokens - cached_tokens) * input + cached_tokens * cached_input +
+         completion_tokens * output) / 1_000_000
+    """
+    if model not in PRICES:
+        raise UnknownModel(f"Model {model} not found")
     price = PRICES[model]
-    return (usage.prompt_tokens * price.input + usage.completion_tokens * price.output) / 1_000_000
+    # Compute raw cost as Decimal
+    raw = ((usage.prompt_tokens - usage.cached_tokens) * price.input +
+            usage.cached_tokens * price.cached_input +
+            usage.completion_tokens * price.output) / Decimal(1_000_000)
+    # Round half-up to 6 decimal places
+    return raw.quantize(Decimal('0.000001'))
+
