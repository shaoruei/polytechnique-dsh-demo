     def top_spenders(self, month: str, n: int) -> List[Tuple[str, Decimal]]:
-        raise NotImplementedError
+        # Sum total cost per user for the given month.
+        totals: Dict[str, Decimal] = {}
+        for e in self.entries:
+            if e.month != month:
+                continue
+            totals[e.user_id] = totals.get(e.user_id, Decimal("0")) + e.cost
+        # Exclude zero‑cost users.
+        items = [(uid, cost) for uid, cost in totals.items() if cost != Decimal("0")]
+        # Sort by cost descending, then user_id ascending.
+        items.sort(key=lambda x: (-x[1], x[0]))
+        return items[:n]
