--- a/gateway/pricing.py
+++ b/gateway/pricing.py
@@ -22,6 +22,17 @@ PRICES = {
 
 
 def request_cost(model: str, usage) -> Decimal:
-    """Cost of one provider call."""
+    """Cost of one provider call, including cached token pricing.
+    The result is rounded half‑up to 6 decimal places as required by SPEC.md.
+    """
     price = PRICES[model]
-    return (usage.prompt_tokens * price.input + usage.completion_tokens * price.output) / 1_000_000
+    # Compute cost per spec: uncached prompt tokens at `input` price, cached tokens at `cached_input`.
+    uncached = usage.prompt_tokens - usage.cached_tokens
+    total = (
+        uncached * price.input
+        + usage.cached_tokens * price.cached_input
+        + usage.completion_tokens * price.output
+    ) / 1_000_000
+    # Round half‑up to exactly 6 decimal places.
+    from decimal import ROUND_HALF_UP
+    return total.quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP)
