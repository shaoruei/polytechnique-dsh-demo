@@ -14,5 +14,32 @@ class FormatDurationTest(unittest.TestCase):
             format_duration(-1)
 
 
+class ParseDurationTest(unittest.TestCase):
+    def test_bare_seconds(self):
+        self.assertEqual(parse_duration("120"), 120)
+        self.assertEqual(parse_duration("0"), 0)
+        self.assertEqual(parse_duration("0s"), 0)
+
+    def test_examples(self):
+        self.assertEqual(parse_duration("1h30m"), 5400)
+        self.assertEqual(parse_duration("1h 30m"), 5400)
+        self.assertEqual(parse_duration("2d"), 2 * 86400)
+        self.assertEqual(parse_duration("1d2h3m4s"), 1 * 86400 + 2 * 3600 + 3 * 60 + 4)
+        self.assertEqual(parse_duration("1H30M"), 5400)
+        self.assertEqual(parse_duration("45s"), 45)
+
+    def test_inverse(self):
+        # Test a range of values that format_duration can produce.
+        for n in [0, 1, 59, 60, 61, 3599, 3600, 86400, 86401, 90061, 1234567]:
+            with self.subTest(seconds=n):
+                self.assertEqual(parse_duration(format_duration(n)), n)
+
+    def test_invalid(self):
+        invalid_cases = ["", "   ", "-5", "1.5h", "3w", "h", "1h 30x", "30m1h", "1h1h", "1h 1h", "1h30", "1 h30m", "1h30m5s2d"]
+        for case in invalid_cases:
+            with self.subTest(case=case):
+                with self.assertRaises(ValueError):
+                    parse_duration(case)
+
 if __name__ == "__main__":
     unittest.main()
